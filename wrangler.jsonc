
{
  "$schema": "https://developers.cloudflare.com/wrangler/config-schema.json",
  "name": "fantube-archive",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantube-db",
      "database_id": "7a9eac9c-5617-4c3c-8706-a5aacd699e9a"
    }
  ]
}
